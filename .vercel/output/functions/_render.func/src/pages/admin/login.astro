---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  credencialesValidas,
  iniciarSesion,
  loginBloqueado,
  registrarIntento,
  restablecerIntentos,
} from '../../lib/auth';

export const prerender = false;

let error = '';

if (Astro.request.method === 'POST') {
  const ip = Astro.clientAddress ?? 'desconocido';
  const fd = await Astro.request.formData();
  const email = (fd.get('email') ?? '').toString();
  const password = (fd.get('password') ?? '').toString();

  if (loginBloqueado(ip)) {
    error = 'Demasiados intentos fallidos. Espera 15 minutos e inténtalo de nuevo.';
  } else if (credencialesValidas(email, password)) {
    iniciarSesion(Astro.cookies);
    restablecerIntentos(ip);
    return Astro.redirect('/admin');
  } else {
    registrarIntento(ip);
    error = 'Correo o contraseña incorrectos.';
  }
}
---

<BaseLayout title="Acceso restringido — La Manada de Chincha" noindex>
  <main class="login-page">
    <form method="post" class="login-card">
      <div class="login-logo" aria-hidden="true">
        <svg width="34" height="34" viewBox="0 0 40 40" fill="none">
          <circle cx="20" cy="20" r="18" fill="#D72638"/>
          <path d="M12 18C12 14 16 10 20 10C24 10 28 14 28 18V22C28 26 24 30 20 30C16 30 12 26 12 22V18Z" fill="white" />
          <rect x="14" y="20" width="12" height="2" rx="1" fill="#D72638" />
        </svg>
      </div>

      <h1 class="login-title">Panel de administración</h1>
      <p class="login-sub">Ingresa tu correo y contraseña para ver los voluntarios de La Manada.</p>

      {error && <p class="login-error" role="alert">{error}</p>}

      <label class="login-field">
        <span class="login-label">Correo electrónico</span>
        <input type="email" name="email" required autocomplete="username" autofocus inputmode="email" />
      </label>

      <label class="login-field">
        <span class="login-label">Contraseña</span>
        <input type="password" name="password" required autocomplete="current-password" />
      </label>

      <button type="submit" class="login-btn">Entrar</button>

      <a href="/" class="login-back">← Volver al sitio</a>
    </form>
  </main>

  <style>
    .login-page {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #282525;
      padding: 2rem 1rem;
    }

    .login-card {
      width: 100%;
      max-width: 24rem;
      background: white;
      border-radius: 1rem;
      padding: 2.5rem 2rem;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
      text-align: center;
    }

    .login-logo {
      display: flex;
      justify-content: center;
      margin-bottom: 1rem;
    }

    .login-title {
      font-family: 'Anton', sans-serif;
      font-size: 1.5rem;
      color: #282525;
      text-transform: uppercase;
      margin-bottom: 0.5rem;
    }

    .login-sub {
      color: rgba(40, 37, 37, 0.65);
      font-size: 0.9rem;
      line-height: 1.5;
      margin-bottom: 1.5rem;
    }

    .login-error {
      background: rgba(215, 38, 56, 0.08);
      border: 1px solid rgba(215, 38, 56, 0.3);
      color: #D72638;
      border-radius: 0.5rem;
      padding: 0.6rem 0.9rem;
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 1.25rem;
    }

    .login-field {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      text-align: left;
      margin-bottom: 1.25rem;
    }

    .login-label {
      font-size: 0.8125rem;
      font-weight: 600;
      color: #282525;
    }

    .login-field input {
      font-family: 'Poppins', sans-serif;
      font-size: 0.9375rem;
      color: #282525;
      border: 1px solid rgba(40, 37, 37, 0.2);
      border-radius: 0.5rem;
      padding: 0.65rem 0.85rem;
      background: #FAFAFA;
    }

    .login-field input:focus {
      outline: none;
      border-color: #D72638;
      box-shadow: 0 0 0 3px rgba(215, 38, 56, 0.15);
      background: white;
    }

    .login-btn {
      width: 100%;
      font-family: 'Anton', sans-serif;
      font-size: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: white;
      background: #D72638;
      border: none;
      border-radius: 0.5rem;
      padding: 0.85rem;
      cursor: pointer;
      transition: background 0.2s;
    }

    .login-btn:hover { background: #b51e2e; }

    .login-back {
      display: inline-block;
      margin-top: 1.25rem;
      font-size: 0.875rem;
      color: rgba(40, 37, 37, 0.6);
      text-decoration: none;
    }

    .login-back:hover { color: #D72638; }
  </style>
</BaseLayout>