---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import VideoGrid from '../components/VideoGrid.astro';
import Footer from '../components/Footer.astro';
import { videos } from '../data/videos';
---

<BaseLayout
  title="Videos de campaña — Zinthia Garay"
  description="Todos los videos de la campaña de Zinthia Garay, candidata a la Alcaldía Provincial de Chincha por Ahora Nación."
>
  <main>
    <Nav />

    <section class="media-hero">
      <div class="media-hero-inner">
        <p class="media-hero-logo">Ahora Nación</p>
        <h1 class="media-hero-title">Videos</h1>
        <p class="media-hero-sub">
          Las historias, propuestas y convicciones de Zinthia Garay. Mira todos los videos de la campaña aquí.
        </p>
      </div>
    </section>

    <section class="media-grid">
      <div class="media-grid-container">
        <VideoGrid videos={videos} />
        <div class="media-back-wrap">
          <a href="/" class="media-back">← Volver al inicio</a>
        </div>
        <p class="media-more-hint">
          ¿Quieres verlos en TikTok? Síguenos en{' '}
          <a href="https://www.tiktok.com/@zinthiagaray" target="_blank" rel="noopener noreferrer">@zinthiagaray</a>.
        </p>
      </div>
    </section>

    <Footer />
  </main>

  <script is:inline async src="https://www.tiktok.com/embed.js"></script>
</BaseLayout>

<style>
  .media-hero {
    padding: 9rem 1rem 4rem;
    background: #282525;
    text-align: center;
  }

  .media-hero-inner {
    max-width: 48rem;
    margin: 0 auto;
  }

  .media-hero-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 9999px;
    padding: 0.5rem 1.5rem;
    margin-bottom: 1.5rem;
    color: white;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .media-hero-title {
    font-family: 'Anton', sans-serif;
    font-size: 3.5rem;
    color: white;
    text-transform: uppercase;
    line-height: 1;
    margin-bottom: 1rem;
  }

  .media-hero-sub {
    color: rgba(229, 226, 217, 0.75);
    max-width: 36rem;
    margin: 0 auto;
    line-height: 1.6;
  }

  .media-grid {
    padding: 4rem 1rem 5rem;
    background: #FAFAFA;
  }

  .media-grid-container {
    max-width: 72rem;
    margin: 0 auto;
  }

  .media-grid-container :global(.video-grid) {
    margin-bottom: 2.5rem;
  }

  .media-back-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 2.5rem;
  }

  .media-back {
    display: inline-block;
    font-family: 'Anton', sans-serif;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: white;
    background: #282525;
    border-radius: 0.75rem;
    padding: 0.8rem 2rem;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
    box-shadow: 0 10px 20px rgba(40, 37, 37, 0.2);
  }

  .media-back:hover {
    background: #D72638;
    transform: translateY(-2px);
  }

  .media-more-hint {
    text-align: center;
    color: rgba(40, 37, 37, 0.7);
    font-size: 0.9375rem;
  }

  .media-more-hint a {
    color: #D72638;
    font-weight: 600;
    text-decoration: none;
  }

  .media-more-hint a:hover {
    text-decoration: underline;
  }
</style>