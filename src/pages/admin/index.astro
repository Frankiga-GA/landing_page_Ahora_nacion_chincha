---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sesionValida } from '../../lib/auth';
import { getVoluntarios, getStats, type Voluntario } from '../../lib/supabase';
import { DISTRITOS, HABILIDADES } from '../../lib/opciones';

export const prerender = false;

if (!sesionValida(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

const url = new URL(Astro.request.url);
const q = url.searchParams.get('q') ?? '';
const distrito = url.searchParams.get('distrito') ?? '';
const habilidad = url.searchParams.get('habilidad') ?? '';

const [{ voluntarios, error }, stats] = await Promise.all([
  getVoluntarios({ q, distrito, habilidad }),
  getStats(),
]);

const fmtFecha = new Intl.DateTimeFormat('es-PE', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
const fmtFechaRegistro = new Intl.DateTimeFormat('es-PE', { day: '2-digit', month: 'short', year: 'numeric' });

function fmtFechaCorta(iso: string | null): string {
  return iso ? fmtFechaRegistro.format(new Date(iso)) : '—';
}

function fmtFechaHora(iso: string | null): string {
  return iso ? fmtFecha.format(new Date(iso)) : '—';
}

function fmtLista(array: string[] | null, otro: string | null): string {
  const base = array ?? [];
  if (otro && base.includes('Otro')) return base.filter((v) => v !== 'Otro').concat(`Otro: ${otro}`).join(' · ');
  return base.join(' · ') || '—';
}

function aTexto(v: string | null): string {
  return v && v.trim() ? v : '—';
}
---

<BaseLayout title="Panel — Voluntarios de La Manada" noindex>
  <main class="admin">
    <header class="admin-head">
      <div>
        <h1 class="admin-title">Voluntarios de La Manada</h1>
        <p class="admin-sub">Registros del formulario "Únete a La Manada".</p>
      </div>
      <div class="admin-actions">
        <a class="admin-btn admin-btn-ghost" href="/">Ver el sitio</a>
        <form method="post" action="/admin/logout">
          <button type="submit" class="admin-btn admin-btn-danger">Salir</button>
        </form>
      </div>
    </header>

    <section class="stats">
      <div class="stat">
        <span class="stat-number">{stats.total}</span>
        <span class="stat-label">Total</span>
      </div>
      <div class="stat">
        <span class="stat-number">{stats.hoy}</span>
        <span class="stat-label">Hoy</span>
      </div>
      <div class="stat">
        <span class="stat-number">{stats.esteMes}</span>
        <span class="stat-label">Este mes</span>
      </div>
      <div class="stat">
        <span class="stat-number">{stats.distritos}</span>
        <span class="stat-label">Distritos</span>
      </div>
    </section>

    {error && <p class="admin-warning" role="alert">{error}</p>}

    <form method="get" class="filters">
      <input type="search" name="q" value={q} placeholder="Buscar por nombre, correo o celular..." class="filter-search" />
      <select name="distrito" class="filter-select">
        <option value="">Todos los distritos</option>
        {DISTRITOS.map((d) => (
          <option value={d} selected={distrito === d}>{d}</option>
        ))}
      </select>
      <select name="habilidad" class="filter-select">
        <option value="">Todas las habilidades</option>
        {HABILIDADES.map((h) => (
          <option value={h} selected={habilidad === h}>{h}</option>
        ))}
      </select>
      <button type="submit" class="admin-btn admin-btn-primary">Filtrar</button>
      {(q || distrito || habilidad) && (
        <a href="/admin" class="admin-btn admin-btn-ghost">Limpiar</a>
      )}
      <span class="filter-count">{voluntarios.length} resultado(s)</span>
    </form>

    {voluntarios.length === 0 ? (
      <p class="empty-state">No hay voluntarios registrados con estos filtros.</p>
    ) : (
      <div class="table-wrap">
        <table class="voluntarios">
          <thead>
            <tr>
              <th>Registro</th>
              <th>Nombre</th>
              <th>Edad</th>
              <th>Distrito</th>
              <th>Perfil</th>
              <th>Celular</th>
              <th>Correo</th>
              <th>Habilidades</th>
              <th>Detalle</th>
            </tr>
          </thead>
          <tbody>
            {voluntarios.map((v: Voluntario) => (
              <tr>
                <td class="cell-date">{fmtFechaCorta(v.creado_en)}</td>
                <td><strong>{v.nombre_completo}</strong></td>
                <td>{v.edad ?? '—'}</td>
                <td>
                  <span class="pill">
                    {v.distrito === 'Otro' ? aTexto(v.distrito_otro) : aTexto(v.distrito)}
                  </span>
                </td>
                <td>{v.perfil === 'Otro' ? aTexto(v.perfil_otro) : aTexto(v.perfil)}</td>
                <td>{aTexto(v.celular)}</td>
                <td class="cell-mail">{aTexto(v.correo)}</td>
                <td><span class="cell-trunc" title={fmtLista(v.habilidades, v.habilidades_otro)}>{fmtLista(v.habilidades, v.habilidades_otro)}</span></td>
                <td>
                  <details class="row-detail">
                    <summary>Ver todo</summary>
                    <dl class="detail-grid">
                      <div><dt>Fecha de nacimiento</dt><dd>{fmtFechaCorta(v.fecha_nacimiento)}</dd></div>
                      <div><dt>Carrera o profesión</dt><dd>{aTexto(v.carrera_profesion)}</dd></div>
                      <div><dt>Centro de estudios / empresa</dt><dd>{aTexto(v.centro_estudios_empresa)}</dd></div>
                      <div><dt>Habilidades</dt><dd>{fmtLista(v.habilidades, v.habilidades_otro)}</dd></div>
                      <div><dt>Cómo ayudaría</dt><dd>{fmtLista(v.como_ayudar, v.como_ayudar_otro)}</dd></div>
                      <div><dt>Disponibilidad</dt><dd>{aTexto(v.disponibilidad)}</dd></div>
                      <div><dt>Redes sociales</dt><dd>{fmtLista(v.redes_sociales, null)}</dd></div>
                      <div><dt>Grupos oficiales</dt><dd>{v.grupos_oficiales ? 'Sí' : 'No'}</dd></div>
                      <div><dt>Coordinar equipo</dt><dd>{v.coordinar_equipo === 'no' ? 'No' : v.coordinar_equipo === 'si' ? 'Sí' : v.coordinar_equipo === 'talvez' ? 'Tal vez' : '—'}</dd></div>
                      <div class="detail-full"><dt>Motivación</dt><dd>{aTexto(v.motivacion)}</dd></div>
                      <div class="detail-full"><dt>Problema y contribución</dt><dd>{aTexto(v.problema_contribucion)}</dd></div>
                      <div><dt>Consentimiento (Ley 29733)</dt><dd>{v.consentimiento ? 'Sí' : 'No'}</dd></div>
                      <div><dt>Registrado</dt><dd>{fmtFechaHora(v.creado_en)}</dd></div>
                    </dl>
                  </details>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    {voluntarios.length > 0 && (
      <div class="export-bar">
        <button type="button" id="export-csv" class="admin-btn admin-btn-primary">Exportar CSV</button>
        <span class="export-hint">Descarga los registros actuales (con filtros aplicados) en formato CSV para Excel/Sheets.</span>
      </div>
    )}
  </main>

  <script is:inline define:vars={{ VOLUNTARIOS: voluntarios }}>
    document.getElementById('export-csv')?.addEventListener('click', () => {
      const columnas = [
        'Registro', 'Nombre completo', 'Edad', 'Fecha de nacimiento', 'Celular', 'Correo',
        'Distrito', 'Distrito (otro)', 'Perfil', 'Perfil (otro)', 'Carrera/Profesión',
        'Centro estudios/empresa', 'Habilidades', 'Habilidad (otro)', 'Cómo ayudar',
        'Cómo ayudar (otro)', 'Disponibilidad', 'Redes sociales', 'Grupos oficiales',
        'Coordinar equipo', 'Motivación', 'Problema y contribución', 'Consentimiento',
      ];
      const filas = VOLUNTARIOS.map((v) => [
        v.creado_en, v.nombre_completo, v.edad ?? '', v.fecha_nacimiento ?? '', v.celular ?? '',
        v.correo ?? '', v.distrito ?? '', v.distrito_otro ?? '', v.perfil ?? '', v.perfil_otro ?? '',
        v.carrera_profesion ?? '', v.centro_estudios_empresa ?? '', (v.habilidades ?? []).join('|'),
        v.habilidades_otro ?? '', (v.como_ayudar ?? []).join('|'), v.como_ayudar_otro ?? '',
        v.disponibilidad ?? '', (v.redes_sociales ?? []).join('|'),
        v.grupos_oficiales ? 'Sí' : 'No', v.coordinar_equipo ?? '',
        v.motivacion ?? '', v.problema_contribucion ?? '', v.consentimiento ? 'Sí' : 'No',
      ]);

      const escapar = (valor) => `"${String(valor ?? '').replace(/"/g, '""')}"`;
      const csv = [columnas, ...filas].map((f) => f.map(escapar).join(',')).join('\r\n');
      const blob = new Blob(["\uFEFF" + csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `voluntarios_${new Date().toISOString().slice(0, 10)}.csv`;
      a.click();
      URL.revokeObjectURL(url);
    });
  </script>

  <style>
    .admin {
      max-width: 90rem;
      margin: 0 auto;
      padding: 2rem 1.25rem 5rem;
    }

    .admin-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 1.5rem;
    }

    .admin-title {
      font-family: 'Anton', sans-serif;
      font-size: 2rem;
      color: #282525;
      text-transform: uppercase;
      margin: 0;
    }

    .admin-sub {
      color: rgba(40, 37, 37, 0.6);
      margin: 0.25rem 0 0;
    }

    .admin-actions {
      display: flex;
      gap: 0.75rem;
      align-items: center;
    }

    .admin-actions form { margin: 0; }

    .admin-btn {
      display: inline-block;
      font-family: 'Poppins', sans-serif;
      font-size: 0.9rem;
      font-weight: 600;
      border: 1px solid transparent;
      border-radius: 0.5rem;
      padding: 0.55rem 1.1rem;
      text-decoration: none;
      cursor: pointer;
      transition: background 0.2s, opacity 0.2s;
    }

    .admin-btn-primary {
      background: #D72638;
      color: white;
    }

    .admin-btn-primary:hover { background: #b51e2e; }

    .admin-btn-ghost {
      background: white;
      border-color: rgba(40, 37, 37, 0.2);
      color: #282525;
    }

    .admin-btn-ghost:hover { background: #f3f4f6; }

    .admin-btn-danger {
      background: white;
      border-color: rgba(215, 38, 56, 0.35);
      color: #D72638;
    }

    .admin-btn-danger:hover { background: rgba(215, 38, 56, 0.08); }

    .stats {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    @media (min-width: 768px) {
      .stats { grid-template-columns: repeat(4, 1fr); }
    }

    .stat {
      background: #282525;
      border-radius: 0.75rem;
      padding: 1.25rem 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }

    .stat-number {
      font-family: 'Anton', sans-serif;
      font-size: 2rem;
      color: white;
      line-height: 1;
    }

    .stat-label {
      color: rgba(229, 226, 217, 0.6);
      font-size: 0.8125rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .admin-warning {
      background: rgba(215, 38, 56, 0.08);
      border: 1px solid rgba(215, 38, 56, 0.3);
      color: #D72638;
      border-radius: 0.5rem;
      padding: 0.75rem 1rem;
      font-weight: 600;
      margin-bottom: 1.25rem;
    }

    .filters {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      align-items: center;
      margin-bottom: 1.5rem;
    }

    .filter-search {
      flex: 1 1 16rem;
      font-family: 'Poppins', sans-serif;
      font-size: 0.9rem;
      border: 1px solid rgba(40, 37, 37, 0.2);
      border-radius: 0.5rem;
      padding: 0.55rem 0.85rem;
      background: white;
    }

    .filter-search:focus,
    .filter-select:focus {
      outline: none;
      border-color: #D72638;
      box-shadow: 0 0 0 3px rgba(215, 38, 56, 0.15);
    }

    .filter-select {
      font-family: 'Poppins', sans-serif;
      font-size: 0.9rem;
      border: 1px solid rgba(40, 37, 37, 0.2);
      border-radius: 0.5rem;
      padding: 0.55rem 0.75rem;
      background: white;
      color: #282525;
    }

    .filter-count {
      margin-left: auto;
      font-size: 0.875rem;
      color: rgba(40, 37, 37, 0.6);
    }

    .table-wrap {
      overflow-x: auto;
      background: white;
      border: 1px solid rgba(40, 37, 37, 0.1);
      border-radius: 0.75rem;
    }

    .voluntarios {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
      min-width: 64rem;
    }

    .voluntarios th {
      text-align: left;
      background: #282525;
      color: rgba(255, 255, 255, 0.9);
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 0.75rem 1rem;
      white-space: nowrap;
    }

    .voluntarios td {
      padding: 0.75rem 1rem;
      border-top: 1px solid rgba(40, 37, 37, 0.07);
      vertical-align: top;
    }

    .voluntarios tbody tr:nth-child(even) { background: rgba(40, 37, 37, 0.03); }

    .cell-date { white-space: nowrap; color: rgba(40, 37, 37, 0.7); }
    .cell-mail { word-break: break-all; }
    .cell-trunc {
      display: inline-block;
      max-width: 12rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      vertical-align: bottom;
    }

    .row-detail { position: relative; }

    .row-detail summary {
      cursor: pointer;
      color: #D72638;
      font-weight: 600;
      font-size: 0.85rem;
      list-style: none;
    }

    .row-detail summary::-webkit-details-marker { display: none; }

    .detail-grid {
      position: absolute;
      right: 0;
      top: 100%;
      z-index: 10;
      min-width: 26rem;
      max-width: min(90vw, 40rem);
      background: white;
      border: 1px solid rgba(40, 37, 37, 0.15);
      border-radius: 0.5rem;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
      padding: 0.5rem 1rem 0.75rem;
      margin: 0.25rem 0 0 0;
    }

    .detail-grid > div { padding-bottom: 0.5rem; border-bottom: 1px dashed rgba(40,37,37,0.12); }
    .detail-grid dt { font-size: 0.72rem; font-weight: 600; color: rgba(40,37,37,0.55); margin-bottom: 0.15rem; }
    .detail-grid dd { margin: 0; font-size: 0.85rem; color: #282525; line-height: 1.5; }
    .detail-full dt, .detail-full dd { white-space: normal; }

    .empty-state {
      background: white;
      border: 1px dashed rgba(40, 37, 37, 0.25);
      border-radius: 0.75rem;
      padding: 2rem;
      text-align: center;
      color: rgba(40, 37, 37, 0.6);
      font-size: 0.95rem;
    }

    .export-bar {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-top: 1.25rem;
    }

    .export-hint { font-size: 0.85rem; color: rgba(40, 37, 37, 0.6); }
  </style>
</BaseLayout>