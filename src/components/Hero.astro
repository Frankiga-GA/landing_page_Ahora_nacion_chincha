---
---

<section class="hero-section">
  <div class="hero-bg"></div>

  <div class="hero-inner">
    <div class="hero-content">
      <div class="hero-badge">
        <span>Ahora Nación</span>
      </div>

      <h1 class="hero-title">Zinthia</h1>
      <p class="hero-subtitle">Alcaldesa Provincial de Chincha</p>

      <blockquote class="hero-quote">
        "No más corruptos e incapaces,<br />
        <span>en la tierra que me vio nacer"</span>
      </blockquote>

      <p class="hero-date">Este 04 de octubre en Chincha, ¡renace la esperanza!</p>

      <div class="hero-actions">
        <a href="#propuestas" class="btn btn-secondary">Conoce mis propuestas</a>
      </div>
    </div>

    <div class="hero-image">
      <img src="/images/foto_portada-recortada.png" alt="Zinthia Garay" />
    </div>
  </div>

  <div class="hero-scroll">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #D72638;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    opacity: 0.1;
  }

  .hero-inner {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
    max-width: 90rem;
    margin: 0 auto;
    padding: 4rem 1rem 0;
  }

  .hero-content {
    text-align: center;
    padding: 0 1rem;
    max-width: 56rem;
    width: 100%;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(4px);
    border-radius: 9999px;
    padding: 0.5rem 1.5rem;
    margin-bottom: 1.5rem;
  }

  .hero-badge span {
    color: white;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero-title {
    font-family: 'Anton', sans-serif;
    font-size: 3.75rem;
    color: white;
    text-transform: uppercase;
    line-height: 1;
    margin-bottom: 1rem;
  }

  .hero-subtitle {
    font-family: 'Anton', sans-serif;
    font-size: 1.25rem;
    color: rgba(255,255,255,0.8);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 2rem;
  }

  .hero-quote {
    font-size: 1.5rem;
    color: white;
    font-weight: 700;
    margin-bottom: 1.5rem;
    line-height: 1.25;
  }

  .hero-quote span {
    color: rgba(255,255,255,0.9);
  }

  .hero-date {
    color: rgba(255,255,255,0.7);
    font-size: 1.125rem;
    margin-bottom: 2.5rem;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: center;
  }

  .btn {
    display: inline-block;
    font-family: 'Anton', sans-serif;
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 1rem 2.5rem;
    border-radius: 0.5rem;
    transition: all 0.2s;
    text-decoration: none;
  }

  .btn-primary {
    background: white;
    color: #D72638;
    box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
  }

  .btn-primary:hover {
    background: #f3f4f6;
  }

  .btn-secondary {
    border: 2px solid white;
    color: white;
  }

  .btn-secondary:hover {
    background: rgba(255,255,255,0.1);
  }

  .hero-image {
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    width: 100%;
    max-height: 40vh;
    overflow: hidden;
  }

  .hero-image img {
    max-height: 40vh;
    width: auto;
    object-fit: contain;
    object-position: bottom;
  }

  .hero-scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    animation: bounce 2s infinite;
    color: rgba(255,255,255,0.6);
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(-10px); }
  }

  @media (min-width: 640px) {
    .hero-inner {
      /* Permite anclar la foto al borde de la portada, no al ancho de la columna. */
      position: static;
    }

    .hero-actions { flex-direction: row; }
  }

  /* Mantiene la composición de dos columnas incluso con zoom del navegador. */
  @media (min-width: 640px) {
    .hero-inner {
      flex-direction: row;
      align-items: center;
      padding: 0 clamp(2rem, 5vw, 4rem);
    }

    .hero-content {
      flex: 0 0 52%;
      text-align: left;
      padding: 0 1.5rem 0 0;
    }

    .hero-title { font-size: 4.75rem; }
    .hero-subtitle { font-size: 1.4rem; }
    .hero-quote { font-size: 1.5rem; }
    .hero-actions { justify-content: flex-start; }
    .hero-badge { transform: translateY(4rem); }

    .hero-image {
      position: absolute;
      top: 0;
      right: 0;
      width: 50vw;
      height: 100vh;
      max-height: none;
      overflow: visible;
      pointer-events: none;
    }

    .hero-image img {
      position: absolute;
      right: clamp(2rem, 8vw, 9rem);
      bottom: -5rem;
      height: 95vh;
      max-height: none;
      width: auto;
      max-width: none;
      object-fit: initial;
      transform: none;
    }
  }

  @media (min-width: 1024px) {
    .hero-content { flex: 0 0 50%; }
    .hero-title { font-size: 8rem; }
    .hero-quote { font-size: 2.25rem; }
  }
</style>
