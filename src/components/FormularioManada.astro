---
import {
  DISTRITOS,
  PERFILES,
  HABILIDADES,
  COMO_AYUDAR,
  DISPONIBILIDAD,
  REDES,
} from '../lib/opciones';

const envKey = (import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '').trim();
const turnstileSiteKey = (envKey && !envKey.startsWith('1x0000') && !envKey.startsWith('2x0000') && !envKey.startsWith('3x0000'))
  ? envKey
  : '0x4AAAAAAEHZP1h0cKxOiYsY';
---

<section class="form-section">
  <div class="form-container">
    <div class="form-header">
      <h2 class="form-title">Únete a La Manada</h2>
      <p class="form-sub">
        Construyamos juntos el futuro de Chincha. Completa el formulario oficial y
        ayúdanos a conocerte para integrarte al equipo donde más puedas aportar.
      </p>
    </div>

    <form id="manada-form" class="form-card">
      <fieldset class="fset">
        <legend class="fset-title">Información personal</legend>
        <div class="field-grid">
          <label class="field field-full">
            <span class="label">Nombre completo <em>*</em></span>
            <input type="text" name="nombre_completo" required autocomplete="name" />
          </label>
          <label class="field">
            <span class="label">Edad</span>
            <input type="number" name="edad" min="1" max="120" inputmode="numeric" autocomplete="bday" />
          </label>
          <label class="field">
            <span class="label">Fecha de nacimiento</span>
            <input type="date" name="fecha_nacimiento" />
          </label>
          <label class="field">
            <span class="label">Celular (WhatsApp)</span>
            <input type="tel" name="celular" inputmode="tel" placeholder="987 654 321" autocomplete="tel" />
          </label>
          <label class="field">
            <span class="label">Correo electrónico <em>*</em></span>
            <input type="email" name="correo" required autocomplete="email" />
          </label>
        </div>
      </fieldset>

      <fieldset class="fset">
        <legend class="fset-title">Distrito donde vives</legend>
        <div class="chip-grid">
          {DISTRITOS.map((d) => (
            <label class="chip">
              <input type="radio" name="distrito" value={d} />
              <span>{d}</span>
            </label>
          ))}
        </div>
        <div id="panel-distrito" class="otro-field hidden">
          <label class="field">
            <span class="label">Indica tu distrito</span>
            <input type="text" name="distrito_otro" class="otro-input" placeholder="Ej. El Guayabo" maxlength="200" />
          </label>
        </div>
      </fieldset>

      <fieldset class="fset">
        <legend class="fset-title">Perfil</legend>
        <p class="fset-hint">Actualmente eres:</p>
        <div class="chip-grid">
          {PERFILES.map((p) => (
            <label class="chip">
              <input type="radio" name="perfil" value={p} />
              <span>{p}</span>
            </label>
          ))}
        </div>
        <div id="perfil-detalle" class="field-grid">
          <label class="field">
            <span class="label">Carrera o profesión</span>
            <input type="text" name="carrera_profesion" />
          </label>
          <label class="field">
            <span class="label">Centro de estudios o empresa</span>
            <input type="text" name="centro_estudios_empresa" />
          </label>
        </div>
        <div id="panel-perfil" class="otro-field hidden">
          <label class="field">
            <span class="label">Indica tu perfil personalizado</span>
            <input type="text" name="perfil_otro" class="otro-input" placeholder="Ej. Artesano, Deportista..." maxlength="200" />
          </label>
        </div>
      </fieldset>

      <fieldset class="fset">
        <legend class="fset-title">Habilidades</legend>
        <p class="fset-hint">¿Qué sabes hacer? (puedes marcar varias)</p>
        <div class="chip-grid">
          {HABILIDADES.map((h) => (
            <label class="chip">
              <input type="checkbox" name="habilidades" value={h} />
              <span>{h}</span>
            </label>
          ))}
        </div>
        <div id="panel-habilidades" class="otro-field hidden">
          <label class="field">
            <span class="label">Indica tu habilidad personalizada</span>
            <input type="text" name="habilidades_otro" class="otro-input" placeholder="Ej. Música, Ventas..." maxlength="200" />
          </label>
        </div>
      </fieldset>

      <fieldset class="fset">
        <legend class="fset-title">¿Cómo te gustaría ayudar?</legend>
        <p class="fset-hint">(puedes marcar varias)</p>
        <div class="chip-grid">
          {COMO_AYUDAR.map((c) => (
            <label class="chip">
              <input type="checkbox" name="como_ayudar" value={c} />
              <span>{c}</span>
            </label>
          ))}
        </div>
        <div id="panel-como-ayudar" class="otro-field hidden">
          <label class="field">
            <span class="label">Indica cómo te gustaría ayudar</span>
            <input type="text" name="como_ayudar_otro" class="otro-input" placeholder="Ej. Administrando redes..." maxlength="200" />
          </label>
        </div>
      </fieldset>

      <fieldset class="fset">
        <legend class="fset-title">Disponibilidad</legend>
        <p class="fset-hint">¿Cuánto tiempo podrías dedicar?</p>
        <div class="chip-grid">
          {DISPONIBILIDAD.map((d) => (
            <label class="chip">
              <input type="radio" name="disponibilidad" value={d} />
              <span>{d}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="fset">
        <legend class="fset-title">Redes sociales</legend>
        <p class="fset-hint">¿Qué redes utilizas? (puedes marcar varias)</p>
        <div class="chip-grid">
          {REDES.map((r) => (
            <label class="chip">
              <input type="checkbox" name="redes_sociales" value={r} />
              <span>{r}</span>
            </label>
          ))}
        </div>
        <p class="fset-hint mt-6">¿Te gustaría formar parte de los grupos oficiales de La Manada? <em>*</em></p>
        <div class="chip-grid">
          <label class="chip">
            <input type="radio" name="grupos_oficiales" value="si" required />
            <span>Sí</span>
          </label>
          <label class="chip">
            <input type="radio" name="grupos_oficiales" value="no" />
            <span>No</span>
          </label>
        </div>
      </fieldset>

      <fieldset class="fset">
        <legend class="fset-title">Liderazgo</legend>
        <p class="fset-hint">¿Te gustaría coordinar un equipo de jóvenes?</p>
        <div class="chip-grid">
          <label class="chip">
            <input type="radio" name="coordinar_equipo" value="si" />
            <span>Sí</span>
          </label>
          <label class="chip">
            <input type="radio" name="coordinar_equipo" value="no" />
            <span>No</span>
          </label>
          <label class="chip">
            <input type="radio" name="coordinar_equipo" value="talvez" />
            <span>Tal vez</span>
          </label>
        </div>
      </fieldset>

      <fieldset class="fset">
        <legend class="fset-title">Motivación</legend>
        <label class="field">
          <span class="label">¿Por qué quieres formar parte de La Manada de Chincha?</span>
          <textarea name="motivacion" rows="4"></textarea>
        </label>
        <label class="field">
          <span class="label">¿Cuál crees que es el principal problema que tiene Chincha y cómo te gustaría contribuir a solucionarlo?</span>
          <textarea name="problema_contribucion" rows="4"></textarea>
        </label>
      </fieldset>

      <label class="consent">
        <input type="checkbox" name="consentimiento" value="1" required />
        <span>
          Autorizo el tratamiento de mis datos personales conforme a la Ley N° 29733
          (Protección de Datos Personales) con fines de contacto e integración al equipo
          de La Manada de Chincha.
        </span>
      </label>

      {turnstileSiteKey && (
        <div class="turnstile-wrap">
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
        </div>
      )}

      <input type="text" name="website" class="honeypot" tabindex="-1" aria-hidden="true" autocomplete="off" />

      <button type="submit" id="manada-submit" class="submit-btn">Únete a La Manada</button>
      <p id="manada-status" class="status hidden" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

{turnstileSiteKey && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script>
  interface TurnstileWindow extends Window {
    turnstile?: {
      getResponse: (el?: Element | null) => string;
      reset: (el?: Element | null) => void;
    };
  }
  declare const window: TurnstileWindow;

  const form = document.getElementById('manada-form') as HTMLFormElement | null;
  if (form) {
    const status = document.getElementById('manada-status');
    const submitBtn = document.getElementById('manada-submit') as HTMLButtonElement | null;
    let sending = false;

    function mostrar(mensaje: string, ok: boolean) {
      if (!status) return;
      status.textContent = mensaje;
      status.classList.remove('hidden', 'status-ok', 'status-error');
      status.classList.add(ok ? 'status-ok' : 'status-error');
    }

    const perfilRadios = form.querySelectorAll<HTMLInputElement>('input[name="perfil"]');
    const perfilDetalle = document.getElementById('perfil-detalle');
    const perfilPanel = document.getElementById('panel-perfil');
    const perfilInput = perfilPanel?.querySelector<HTMLInputElement>('.otro-input');

    function setPerfilOtro() {
      const esOtro = [...perfilRadios].some((r) => r.checked && r.value === 'Otro');
      if (perfilPanel) perfilPanel.classList.toggle('hidden', !esOtro);
      if (perfilInput) perfilInput.required = esOtro;
      if (perfilDetalle) {
        perfilDetalle.querySelectorAll<HTMLInputElement>('input').forEach((el) => { el.disabled = esOtro; });
        perfilDetalle.style.display = esOtro ? 'none' : '';
      }
    }
    perfilRadios.forEach((r) => r.addEventListener('change', setPerfilOtro));

    function setUpRadioOtro(name: string, panelId: string) {
      if (!form) return;
      const radios = form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`);
      const panel = document.getElementById(panelId);
      const input = panel?.querySelector<HTMLInputElement>('.otro-input');
      function update() {
        const esOtro = [...radios].some((r) => r.checked && r.value === 'Otro');
        if (panel) panel.classList.toggle('hidden', !esOtro);
        if (input) input.required = esOtro;
      }
      radios.forEach((r) => r.addEventListener('change', update));
      update();
    }

    function setCheckboxOtro(name: string, panelId: string) {
      if (!form) return;
      const cb = form.querySelector<HTMLInputElement>(`input[name="${name}"][value="Otro"]`);
      const panel = document.getElementById(panelId);
      const input = panel?.querySelector<HTMLInputElement>('.otro-input');
      function update() {
        const esOtro = Boolean(cb?.checked);
        if (panel) panel.classList.toggle('hidden', !esOtro);
        if (input) input.required = esOtro;
      }
      cb?.addEventListener('change', update);
      update();
    }

    setPerfilOtro();
    setUpRadioOtro('distrito', 'panel-distrito');
    setCheckboxOtro('habilidades', 'panel-habilidades');
    setCheckboxOtro('como_ayudar', 'panel-como-ayudar');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending) return;
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const body = new FormData(form);
      if (body.get('website')) return;

      let token = body.get('cf-turnstile-response')?.toString() ?? '';
      if (!token && window.turnstile) {
        const widget = document.querySelector('.cf-turnstile');
        if (widget) token = window.turnstile.getResponse(widget) ?? '';
      }
      if (token) body.set('cf-turnstile-response', token);

      sending = true;
      if (submitBtn) submitBtn.disabled = true;
      mostrar('Enviando...', true);

      try {
        const res = await fetch('/api/voluntarios', { method: 'POST', body });
        const data = await res.json().catch(() => ({}));
        if (res.ok) {
          mostrar('¡Bienvenido a La Manada! Pronto nos comunicaremos contigo.', true);
          form.reset();
          if (window.turnstile) window.turnstile.reset();
        } else {
          mostrar(data.error ?? 'No se pudo enviar. Inténtalo nuevamente.', false);
        }
      } catch {
        mostrar('Error de conexión. Verifica tu internet e inténtalo nuevamente.', false);
      }

      sending = false;
      if (submitBtn) submitBtn.disabled = false;
    });
  }
</script>

<style>
  .form-section {
    padding: 5rem 1rem;
    background: #D72638;
  }

  @media (min-width: 768px) {
    .form-section { padding: 8rem 1rem; }
  }

  .form-container { max-width: 56rem; margin: 0 auto; }

  .form-header { text-align: center; margin-bottom: 3rem; }

  .form-title {
    font-family: 'Anton', sans-serif;
    font-size: 2.25rem;
    color: white;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .form-title { font-size: 3rem; }
  }

  .form-sub {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.125rem;
    line-height: 1.6;
    max-width: 42rem;
    margin: 0 auto;
  }

  .form-card {
    background: white;
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  }

  @media (min-width: 768px) {
    .form-card { padding: 2.5rem; }
  }

  .fset {
    border: none;
    margin: 0 0 2rem;
    padding: 0;
  }

  .fset-title {
    font-family: 'Anton', sans-serif;
    font-size: 1.25rem;
    color: #D72638;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    border-bottom: 2px solid rgba(215, 38, 56, 0.15);
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
    width: 100%;
  }

  .fset-hint {
    color: rgba(40, 37, 37, 0.7);
    font-size: 0.9rem;
    margin: 0 0 0.75rem;
  }

  .fset-hint em { color: #D72638; }

  .field-grid {
    display: grid;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 640px) {
    .field-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .field-full { grid-column: 1 / -1; }

  .otro-field {
    border: 1px dashed rgba(215, 38, 56, 0.4);
    background: rgba(215, 38, 56, 0.04);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
  }

  .label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #282525;
  }

  .label em { color: #D72638; }

  .field input,
  .field textarea {
    font-family: 'Poppins', sans-serif;
    font-size: 0.9375rem;
    color: #282525;
    border: 1px solid rgba(40, 37, 37, 0.2);
    border-radius: 0.5rem;
    padding: 0.6rem 0.85rem;
    background: #FAFAFA;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .field textarea {
    resize: vertical;
    min-height: 5rem;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: #D72638;
    box-shadow: 0 0 0 3px rgba(215, 38, 56, 0.15);
    background: white;
  }

  .chip-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .chip span {
    display: inline-block;
    padding: 0.45rem 1rem;
    border: 1px solid rgba(40, 37, 37, 0.25);
    border-radius: 9999px;
    background: white;
    color: #282525;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    user-select: none;
  }

  .chip span:hover {
    border-color: #D72638;
  }

  .chip input:checked + span {
    background: #D72638;
    border-color: #D72638;
    color: white;
  }

  .chip input:focus-visible + span {
    outline: 2px solid #D72638;
    outline-offset: 2px;
  }

  .mt-6 { margin-top: 1.5rem; }

  .consent {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: #FAFAFA;
    border: 1px solid rgba(40, 37, 37, 0.15);
    border-radius: 0.5rem;
    padding: 0.9rem 1rem;
    margin-bottom: 1.25rem;
    cursor: pointer;
    font-size: 0.8125rem;
    color: rgba(40, 37, 37, 0.8);
    line-height: 1.5;
  }

  .consent input {
    margin-top: 0.2rem;
    accent-color: #D72638;
  }

  .turnstile-wrap {
    margin-bottom: 1.25rem;
    min-height: 4.5rem;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    width: 0;
  }

  .submit-btn {
    display: block;
    width: 100%;
    font-family: 'Anton', sans-serif;
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: white;
    background: #D72638;
    border: none;
    border-radius: 0.5rem;
    padding: 1rem 2rem;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
  }

  .submit-btn:hover { background: #b51e2e; }

  .submit-btn:active { transform: scale(0.99); }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .status {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .status-ok { color: #1a7f37; }
  .status-error { color: #D72638; }

  .hidden { display: none; }
</style>
