<footer class="footer">
  <div class="footer-container">
    <div class="footer-top">
      <div>
        <p class="footer-name">Zinthia Garay</p>
        <p class="footer-role">Alcaldesa Provincial de Chincha · Ahora Nación</p>
      </div>
      <div class="footer-party">
        <svg width="32" height="32" viewBox="0 0 40 40" fill="none">
          <circle cx="20" cy="20" r="18" fill="white" fill-opacity="0.1"/>
          <path d="M12 18C12 14 16 10 20 10C24 10 28 14 28 18V22C28 26 24 30 20 30C16 30 12 26 12 22V18Z" fill="white" />
          <rect x="14" y="20" width="12" height="2" rx="1" fill="#282525" />
        </svg>
        <span>Ahora Nación</span>
      </div>
    </div>



    <div class="footer-bottom">
      <p class="footer-copy">&copy; 2026 · Organización Política Ahora Nación</p>
      <p class="footer-quote">"Este 04 de octubre en Chincha, ¡renace la esperanza!"</p>
      <p class="footer-tagline">No más corruptos e incapaces, en la tierra que me vio nacer</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #282525;
    padding: 3rem 1rem;
  }

  .footer-container {
    max-width: 72rem;
    margin: 0 auto;
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .footer-top { flex-direction: row; }
  }

  .footer-name {
    font-family: 'Anton', sans-serif;
    font-size: 1.5rem;
    color: white;
    text-transform: uppercase;
  }

  .footer-role {
    color: rgba(229,226,217,0.6);
    font-size: 0.875rem;
  }

  .footer-party {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(229,226,217,0.5);
    font-size: 0.875rem;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-top: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .footer-bottom { flex-direction: row; justify-content: space-between; }
  }

  .footer-copy {
    color: rgba(229,226,217,0.4);
    font-size: 0.875rem;
  }

  .footer-quote {
    color: rgba(229,226,217,0.6);
    font-family: 'Anton', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: center;
    font-size: 1.125rem;
  }

  .footer-tagline {
    color: rgba(229,226,217,0.3);
    font-size: 0.75rem;
    text-align: center;
  }
</style>
