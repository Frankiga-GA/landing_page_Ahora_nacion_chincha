---
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const DISTRITOS = [
  'Chincha Alta', 'Pueblo Nuevo', 'Grocio Prado', 'Alto Larán',
  'Sunampe', 'Chincha Baja', 'Tambo de Mora', 'El Carmen', 'Otro',
];

const PERFILES = [
  'Estudiante', 'Profesional', 'Técnico', 'Emprendedor',
  'Comerciante', 'Agricultor', 'Trabajador independiente', 'Otro',
];

const HABILIDADES = [
  'Diseño gráfico', 'Edición de video', 'Fotografía', 'Producción audiovisual',
  'Redes sociales', 'TikTok', 'Facebook', 'Instagram', 'Community Manager',
  'Marketing', 'Publicidad', 'Organización de eventos', 'Logística', 'Tecnología',
  'Programación', 'Inteligencia Artificial', 'Comunicación', 'Relaciones Públicas',
  'Oratoria', 'Música', 'Deportes', 'Educación', 'Salud', 'Derecho',
  'Administración', 'Otro',
];

const COMO_AYUDAR = [
  'Difundiendo contenido', 'Creando videos', 'Diseñando publicaciones',
  'Tomando fotografías', 'Grabando eventos', 'Organización de actividades',
  'Apoyo en campañas digitales', 'Convocando jóvenes', 'Voluntariado en eventos',
  'Capacitando personas', 'Otro',
];

const DISPONIBILIDAD = ['1 a 2 horas', '3 a 5 horas', 'Más de 5 horas', 'Solo fines de semana', 'Según necesidad'];

const REDES = ['Facebook', 'TikTok', 'Instagram', 'WhatsApp', 'Telegram', 'LinkedIn'];
---

<section id="unete" class="unete-section">
  <div class="unete-container">
    <div class="unete-header">
      <h2 class="unete-title">Únete a La Manada</h2>
      <p class="unete-sub">
        Construyamos juntos el futuro de Chincha. Completa el formulario oficial y
        ayúdanos a conocerte para integrarte al equipo donde más puedas aportar.
      </p>
    </div>

    <form id="manada-form" class="form-card">
      <fieldset class="fset">
        <legend class="fset-title">Información personal</legend>
        <div class="field-grid">
          <label class="field field-full">
            <span class="label">Nombre completo <em>*</em></span>
            <input type="text" name="nombre_completo" required autocomplete="name" />
          </label>
          <label class="field">
            <span class="label">Edad</span>
            <input type="number" name="edad" min="1" max="120" inputmode="numeric" autocomplete="bday" />
          </label>
          <label class="field">
            <span class="label">Fecha de nacimiento</span>
            <input type="date" name="fecha_nacimiento" />
          </label>
          <label class="field">
            <span class="label">Celular (WhatsApp)</span>
            <input type="tel" name="celular" inputmode="tel" placeholder="987 654 321" autocomplete="tel" />
          </label>
          <label class="field">
            <span class="label">Correo electrónico <em>*</em></span>
            <input type="email" name="correo" required autocomplete="email" />
          </label>
        </div>
      </fieldset>

      <fieldset class="fset">
        <legend class="fset-title">Distrito donde vives</legend>
        <div class="chip-grid">
          {DISTRITOS.map((d) => (
            <label class="chip">
              <input type="radio" name="distrito" value={d} />
              <span>{d}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="fset">
        <legend class="fset-title">Perfil</legend>
        <p class="fset-hint">Actualmente eres:</p>
        <div class="chip-grid">
          {PERFILES.map((p) => (
            <label class="chip">
              <input type="radio" name="perfil" value={p} />
              <span>{p}</span>
            </label>
          ))}
        </div>
        <div class="field-grid">
          <label class="field">
            <span class="label">Carrera o profesión</span>
            <input type="text" name="carrera_profesion" />
          </label>
          <label class="field">
            <span class="label">Centro de estudios o empresa</span>
            <input type="text" name="centro_estudios_empresa" />
          </label>
        </div>
      </fieldset>

      <fieldset class="fset">
        <legend class="fset-title">Habilidades</legend>
        <p class="fset-hint">¿Qué sabes hacer? (puedes marcar varias)</p>
        <div class="chip-grid">
          {HABILIDADES.map((h) => (
            <label class="chip">
              <input type="checkbox" name="habilidades" value={h} />
              <span>{h}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="fset">
        <legend class="fset-title">¿Cómo te gustaría ayudar?</legend>
        <p class="fset-hint">(puedes marcar varias)</p>
        <div class="chip-grid">
          {COMO_AYUDAR.map((c) => (
            <label class="chip">
              <input type="checkbox" name="como_ayudar" value={c} />
              <span>{c}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="fset">
        <legend class="fset-title">Disponibilidad</legend>
        <p class="fset-hint">¿Cuánto tiempo podrías dedicar?</p>
        <div class="chip-grid">
          {DISPONIBILIDAD.map((d) => (
            <label class="chip">
              <input type="radio" name="disponibilidad" value={d} />
              <span>{d}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="fset">
        <legend class="fset-title">Redes sociales</legend>
        <p class="fset-hint">¿Qué redes utilizas? (puedes marcar varias)</p>
        <div class="chip-grid">
          {REDES.map((r) => (
            <label class="chip">
              <input type="checkbox" name="redes_sociales" value={r} />
              <span>{r}</span>
            </label>
          ))}
        </div>
        <p class="fset-hint mt-6">¿Te gustaría formar parte de los grupos oficiales de La Manada? <em>*</em></p>
        <div class="chip-grid">
          <label class="chip">
            <input type="radio" name="grupos_oficiales" value="si" required />
            <span>Sí</span>
          </label>
          <label class="chip">
            <input type="radio" name="grupos_oficiales" value="no" />
            <span>No</span>
          </label>
        </div>
      </fieldset>

      <fieldset class="fset">
        <legend class="fset-title">Liderazgo</legend>
        <p class="fset-hint">¿Te gustaría coordinar un equipo de jóvenes?</p>
        <div class="chip-grid">
          <label class="chip">
            <input type="radio" name="coordinar_equipo" value="si" />
            <span>Sí</span>
          </label>
          <label class="chip">
            <input type="radio" name="coordinar_equipo" value="no" />
            <span>No</span>
          </label>
          <label class="chip">
            <input type="radio" name="coordinar_equipo" value="talvez" />
            <span>Tal vez</span>
          </label>
        </div>
      </fieldset>

      <fieldset class="fset">
        <legend class="fset-title">Motivación</legend>
        <label class="field">
          <span class="label">¿Por qué quieres formar parte de La Manada de Chincha?</span>
          <textarea name="motivacion" rows="4"></textarea>
        </label>
        <label class="field">
          <span class="label">¿Cuál crees que es el principal problema que tiene Chincha y cómo te gustaría contribuir a solucionarlo?</span>
          <textarea name="problema_contribucion" rows="4"></textarea>
        </label>
      </fieldset>

      <label class="consent">
        <input type="checkbox" name="consentimiento" value="1" required />
        <span>
          Autorizo el tratamiento de mis datos personales conforme a la Ley N° 29733
          (Protección de Datos Personales) con fines de contacto e integración al equipo
          de La Manada de Chincha.
        </span>
      </label>

      {turnstileSiteKey && (
        <div class="turnstile-wrap">
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
        </div>
      )}

      <input type="text" name="website" class="honeypot" tabindex="-1" aria-hidden="true" autocomplete="off" />

      <button type="submit" id="manada-submit" class="submit-btn">Únete a La Manada</button>
      <p id="manada-status" class="status hidden" role="status" aria-live="polite"></p>
    </form>

    <div class="unete-social-note">
      <p>¿Prefieres escribirnos? Encuéntranos en nuestras redes sociales:</p>
    </div>

    <div class="unete-social">
      <a href="https://www.tiktok.com/@zinthiagaray" target="_blank" rel="noopener noreferrer" class="social-card" aria-label="TikTok">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
        </svg>
        <span class="social-name">TikTok</span>
      </a>

      <a href="https://www.facebook.com/zinthia.garay.paucar#" target="_blank" rel="noopener noreferrer" class="social-card" aria-label="Facebook">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
        <span class="social-name">Facebook</span>
      </a>

      <a href="https://www.instagram.com/zinthiagaray_ig/" target="_blank" rel="noopener noreferrer" class="social-card" aria-label="Instagram">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
        </svg>
        <span class="social-name">Instagram</span>
      </a>

      <a href="https://www.linkedin.com/in/zinthia-garay-448528257/" target="_blank" rel="noopener noreferrer" class="social-card" aria-label="LinkedIn">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        <span class="social-name">LinkedIn</span>
      </a>
    </div>
  </div>
</section>

{turnstileSiteKey && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script>
  const form = document.getElementById('manada-form');
  if (form) {
    const status = document.getElementById('manada-status');
    const submitBtn = document.getElementById('manada-submit');
    let sending = false;

    function mostrar(mensaje, ok) {
      status.textContent = mensaje;
      status.classList.remove('hidden', 'status-ok', 'status-error');
      status.classList.add(ok ? 'status-ok' : 'status-error');
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending) return;
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const body = new FormData(form);
      if (body.get('website')) return; // honeypot: los bots no llegan aquí

      let token = body.get('cf-turnstile-response')?.toString() ?? '';
      if (!token && window.turnstile) {
        const widget = document.querySelector('.cf-turnstile');
        if (widget) token = window.turnstile.getResponse(widget) ?? '';
      }
      if (token) body.set('cf-turnstile-response', token);

      sending = true;
      submitBtn.disabled = true;
      mostrar('Enviando...', true);

      try {
        const res = await fetch('/api/voluntarios', { method: 'POST', body });
        const data = await res.json().catch(() => ({}));
        if (res.ok) {
          mostrar('¡Bienvenido a La Manada! Pronto nos comunicaremos contigo.', true);
          form.reset();
          if (window.turnstile) window.turnstile.reset();
        } else {
          mostrar(data.error ?? 'No se pudo enviar. Inténtalo nuevamente.', false);
        }
      } catch {
        mostrar('Error de conexión. Verifica tu internet e inténtalo nuevamente.', false);
      }

      sending = false;
      submitBtn.disabled = false;
    });
  }
</script>

<style>
  .unete-section {
    padding: 5rem 1rem;
    background: #D72638;
  }

  @media (min-width: 768px) {
    .unete-section { padding: 8rem 1rem; }
  }

  .unete-container { max-width: 56rem; margin: 0 auto; }

  .unete-header { text-align: center; margin-bottom: 3rem; }

  .unete-title {
    font-family: 'Anton', sans-serif;
    font-size: 2.25rem;
    color: white;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .unete-title { font-size: 3rem; }
  }

  .unete-sub {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.125rem;
    line-height: 1.6;
    max-width: 42rem;
    margin: 0 auto;
  }

  .form-card {
    background: white;
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  }

  @media (min-width: 768px) {
    .form-card { padding: 2.5rem; }
  }

  .fset {
    border: none;
    margin: 0 0 2rem;
    padding: 0;
  }

  .fset-title {
    font-family: 'Anton', sans-serif;
    font-size: 1.25rem;
    color: #D72638;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    border-bottom: 2px solid rgba(215, 38, 56, 0.15);
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
    width: 100%;
  }

  .fset-hint {
    color: rgba(40, 37, 37, 0.7);
    font-size: 0.9rem;
    margin: 0 0 0.75rem;
  }

  .fset-hint em { color: #D72638; }

  .field-grid {
    display: grid;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 640px) {
    .field-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .field-full { grid-column: 1 / -1; }

  .label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #282525;
  }

  .label em { color: #D72638; }

  .field input,
  .field textarea {
    font-family: 'Poppins', sans-serif;
    font-size: 0.9375rem;
    color: #282525;
    border: 1px solid rgba(40, 37, 37, 0.2);
    border-radius: 0.5rem;
    padding: 0.6rem 0.85rem;
    background: #FAFAFA;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .field textarea {
    resize: vertical;
    min-height: 5rem;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: #D72638;
    box-shadow: 0 0 0 3px rgba(215, 38, 56, 0.15);
    background: white;
  }

  .chip-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .chip span {
    display: inline-block;
    padding: 0.45rem 1rem;
    border: 1px solid rgba(40, 37, 37, 0.25);
    border-radius: 9999px;
    background: white;
    color: #282525;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    user-select: none;
  }

  .chip span:hover {
    border-color: #D72638;
  }

  .chip input:checked + span {
    background: #D72638;
    border-color: #D72638;
    color: white;
  }

  .chip input:focus-visible + span {
    outline: 2px solid #D72638;
    outline-offset: 2px;
  }

  .mt-6 { margin-top: 1.5rem; }

  .consent {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: #FAFAFA;
    border: 1px solid rgba(40, 37, 37, 0.15);
    border-radius: 0.5rem;
    padding: 0.9rem 1rem;
    margin-bottom: 1.25rem;
    cursor: pointer;
    font-size: 0.8125rem;
    color: rgba(40, 37, 37, 0.8);
    line-height: 1.5;
  }

  .consent input {
    margin-top: 0.2rem;
    accent-color: #D72638;
  }

  .turnstile-wrap {
    margin-bottom: 1.25rem;
    min-height: 4.5rem;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    width: 0;
  }

  .submit-btn {
    display: block;
    width: 100%;
    font-family: 'Anton', sans-serif;
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: white;
    background: #D72638;
    border: none;
    border-radius: 0.5rem;
    padding: 1rem 2rem;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
  }

  .submit-btn:hover { background: #b51e2e; }

  .submit-btn:active { transform: scale(0.99); }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .status {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .status-ok { color: #1a7f37; }
  .status-error { color: #D72638; }

  .hidden { display: none; }

  .unete-social-note {
    text-align: center;
    color: rgba(255, 255, 255, 0.9);
    margin: 3rem 0 1.5rem;
    font-size: 1rem;
  }

  .unete-social {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    max-width: 28rem;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    .unete-social { grid-template-columns: repeat(4, 1fr); max-width: 36rem; }
  }

  .social-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 1.5rem 1rem;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    text-decoration: none;
    color: white;
    transition: all 0.2s;
  }

  .social-card:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-4px);
  }

  .social-name {
    font-family: 'Anton', sans-serif;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
